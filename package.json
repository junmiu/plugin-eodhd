{
  "name": "plugin-eodhd",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "prestart": "npm run build && npm run copy:schema",
    "dev": "ts-node src/server.ts",
    "copy:schema": "cp src/graphql/schema.graphql dist/graphql/schema.graphql",
    "seed": "knex seed:run"
  },
  "dependencies": {
    "axios": "^0.21.1",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "graphql": "^16.11.0",
    "graphql-http": "^1.22.4",
    "jsonwebtoken": "^8.5.1",
    "knex": "^3.1.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.13",
    "@types/jsonwebtoken": "^8.5.5",
    "@types/node": "^16.11.7",
    "ts-node": "^10.4.0",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
